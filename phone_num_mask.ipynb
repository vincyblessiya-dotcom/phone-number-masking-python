      "source": [
        "def mask_phone_number(phone):\n",
        "    return phone[:-5] + \"*****\"\n",
        "\n",
        "phone = input(\"Enter your phone number: \")\n",
        "\n",
        "result = mask_phone_number(phone)\n",
        "\n",
        "print(\"Masked phone number:\", result)"
      ]
